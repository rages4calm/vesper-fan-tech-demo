  "speech": [
    {
      "duration": 7.38133333333333,
      "id": "welcome_0",
      "position": [
        -4.0,
        1.95109367370605,
        -117.0
      ],
      "speaker": "crier",
      "text": "Hear ye, good people of Vesper! Welcome to the city of bridges. Keep the quays clear, and lend an ear to your neighbours.",
      "time": 7.00241666666672
    },
    {
      "duration": 5.78133333333333,
      "id": "courier_request_0",
      "position": [
        -4.0,
        1.95109367370605,
        -117.0
      ],
      "speaker": "crier",
      "text": "Elowen, could you take a basket from Lysa to the Marsh Hall? The kitchen is short of bread.",
      "time": 17.0021666666663
    },
    {
      "duration": 4.01066666666667,
      "id": "courier_accept_0",
      "position": [
        -6.0,
        1.95109367370605,
        -117.0
      ],
      "speaker": "elowen",
      "text": "I can help. I will collect the bread from Lysa, then carry it to Garrick.",
      "time": 23.721998666666
    },
    {
      "duration": 5.03466666666667,
      "id": "chat_barkeep_0",
      "position": [
        10.2823400497437,
        2.02531242370605,
        70.0
      ],
      "speaker": "barkeep",
      "text": "A warm table takes more than a fire. Someone has to bring the fish and bread.",
      "time": 144.188496333339
    },
    {
      "duration": 2.73066666666667,
      "id": "reply_neighbour_6_0",
      "position": [
        10.9993419647217,
        2.0108163356781,
        73.2822570800781
      ],
      "speaker": "neighbour_6",
      "text": "That sounds like a good reason to stop at the tavern.",
      "time": 150.441673333334
    },
    {
      "duration": 4.05333333333333,
      "id": "fish_offer_0",
      "position": [
        11.0462846755981,
        2.02586364746094,
        71.3258285522461
      ],
      "speaker": "fisherman",
      "text": "Garrick, the catch is landed. I can bring three fresh fish to your kitchen.",
      "time": 156.694850333329
    },
    {
      "duration": 6.464,
      "id": "fish_thanks_0",
      "position": [
        10.2823400497437,
        2.02531242370605,
        70.0
      ],
      "speaker": "barkeep",
      "text": "Well caught, Corin. I will take the three fish. There is room for you at the table when your work is done.",
      "time": 161.401399333325
    },
    {
      "duration": 4.62933333333333,
      "id": "remedies_arrival_0",
      "position": [
        -96.7855224609375,
        2.02486371994019,
        126.226379394531
      ],
      "speaker": "neighbour_7",
      "text": "Sella, the remedies have arrived. Two jars from Anwen, safely carried.",
      "time": 302.209949666541
    },
    {
      "duration": 3.008,
      "id": "remedies_thanks_0",
      "position": [
        -98.00244140625,
        2.0097119808197,
        125.278747558594
      ],
      "speaker": "innkeeper",
      "text": "Thank you, Bram. I will keep them ready for our guests.",
      "time": 307.929806666537
    },
    {
      "duration": 4.13866666666667,
      "id": "chat_innkeeper_0",
      "position": [
        -98.00244140625,
        2.0097119808197,
        125.278747558594
      ],
      "speaker": "innkeeper",
      "text": "Travellers bring stories with their muddy boots. I could listen all evening.",
      "time": 312.436360666533
    },
    {
      "duration": 2.77333333333333,
      "id": "reply_neighbour_7_0",
      "position": [
        -95.8742980957031,
        2.01021528244019,
        127.127174377441
      ],
      "speaker": "neighbour_7",
      "text": "I will see you again when my errands are done.",
      "time": 317.649563666528
    },
    {
      "duration": 6.16533333333333,
      "id": "bread_open_0",
      "position": [
        -3.99985003471375,
        1.95090842247009,
        -117.234848022461
      ],
      "speaker": "crier",
      "text": "The Twisted Oven sells warm bread for two gold a loaf. Ask Lysa when you reach her shop.",
      "time": 397.042882333129
    },
    {
      "duration": 4.096,
      "id": "social_hello_0",
      "position": [
        -6.99999284744263,
        1.95089161396027,
        -113.70866394043
      ],
      "speaker": "resident_living",
      "text": "Good day, Elowen. You look as though you have crossed every bridge in Vesper.",
      "time": 422.497236999775
    },
    {
      "duration": 3.47733333333333,
      "id": "social_reply_0",
      "position": [
        -5.99999761581421,
        1.9500846862793,
        -116.721397399902
      ],
      "speaker": "elowen",
      "text": "More than a few bridges, Nessa. A warm meal will be welcome.",
      "time": 427.310449999771
    },
    {
      "duration": 6.336,
      "id": "remedies_news_0",
      "position": [
        -4.23200225830078,
        1.95090842247009,
        -116.945747375488
      ],
      "speaker": "crier",
      "text": "News from the Ironwood Inn. Bram has brought Anwen's remedies to Sella. The jars arrived safely.",
      "time": 462.109579999741
    },
    {
      "duration": 5.78133333333333,
