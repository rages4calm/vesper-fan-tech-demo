    {
      "duration": 5.248,
      "id": "bread_thanks_0",
      "position": [
        7.43127393722534,
        1.99753832817078,
        70.5383605957031
      ],
      "speaker": "barkeep",
      "text": "Thank you, Elowen. That is one promise kept and four good loaves in the kitchen.",
