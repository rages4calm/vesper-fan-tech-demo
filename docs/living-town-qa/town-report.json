    {
      "duration": 6.464,
      "id": "fish_thanks_0",
      "position": [
        7.43127393722534,
        1.99753832817078,
        70.5383605957031
      ],
      "speaker": "barkeep",
      "text": "Well caught, Corin. I will take the three fish. There is room for you at the table when your work is done.",
