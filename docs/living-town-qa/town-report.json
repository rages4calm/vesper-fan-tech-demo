      "duration": 4.05333333333333,
      "id": "fish_offer_0",
      "position": [
        9.28192234039307,
        2.01031732559204,
        72.3025512695313
      ],
      "speaker": "fisherman",
      "text": "Garrick, the catch is landed. I can bring three fresh fish to your kitchen.",
      "time": 120.501109333351
