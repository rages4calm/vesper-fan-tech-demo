    },
    {
      "duration": 4.84266666666667,
      "id": "meal_empty_0",
      "position": [
        7.43127393722534,
        1.99753832817078,
        70.5383605957031
      ],
      "speaker": "barkeep",
      "text": "I am waiting for supplies before I can serve that. Give me a little time.",
      "time": 158.45390866666
    },
    {
      "duration": 4.71466666666667,
      "id": "bread_arrival_0",
      "position": [
        5.0054759979248,
        2.01035594940186,
        71.387825012207
      ],
      "speaker": "elowen",
      "text": "Garrick, I brought Lysa's bread. All four loaves, and not a crumb lost on the bridges.",
