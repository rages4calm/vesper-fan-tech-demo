      "id": "chat_neighbour_6_0",
      "position": [
        1.0117175579071,
        2.14646053314209,
        78.0
      ],
      "speaker": "neighbour_6",
      "text": "I make pots for people who use them. The prettiest one still needs to hold water.",
      "time": 80.0966363333426
    },
