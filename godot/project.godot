; Vesper: City of Bridges — native Godot 4.7 project
config_version=5

[application]
config/name="Vesper — City of Bridges"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/crest.svg"
config/description="A playable tribute to the Vesper of Ultima Online."
config/version="0.3.2"
config/use_custom_user_dir=true
config/custom_user_dir_name="Vesper Fan Tech Demo"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssao/half_size=false
environment/defaults/default_clear_color=Color(0.1,0.18,0.21,1)

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="GodotPhysics3D"

[filesystem]
import/blender/enabled=false
